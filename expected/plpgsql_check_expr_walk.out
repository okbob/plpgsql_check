(2 rows)

--
-- collecting of the dependencies
--
-- an operator that is not in pg_catalog is a dependency of the routine,
-- a prefix operator has no type on its left side
create function ew_neg(int)
returns int as $$ select -$1 $$ language sql immutable;
create operator @# (function = ew_neg, rightarg = int);
create function ew_f29(n int)
returns int as $$
begin
  return @# n;
end;
$$ language plpgsql;
select type, schema, name, params from plpgsql_show_dependency_tb('ew_f29');
   type   | schema | name |   params    
----------+--------+------+-------------
 OPERATOR | public | @#   | (-,integer)
(1 row)

