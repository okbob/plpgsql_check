create function tf_f4()
returns void as $$
declare r record;
begin
  create temp table tf_tmp as select 1 as a, 2 as b;
  select * from tf_tmp into r;
  raise notice '%', r.a;
end;
$$ language plpgsql;
select * from plpgsql_make_pragma('tf_f4()');
         plpgsql_make_pragma         
-------------------------------------
 table: tf_tmp(a integer, b integer)
(1 row)

drop function tf_f4();
